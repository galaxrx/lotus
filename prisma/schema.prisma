// Niloosa data model — hand-painted wall-art commissioning.
// Guest checkout: an Order needs no user account. Prisma connects directly to
// Postgres; because there is no multi-tenant/user data here, all access is
// server-side only (API routes), never exposed to the browser.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A guest commission: the customer names a price (an offer) on a piece, which the
// owner brokers to an artist. Sensitive contact fields live here but are only ever
// read server-side (RLS denies the anon key). See docs/SYSTEM_DESIGN.md §4.
model Order {
  id            String   @id @default(uuid()) @db.Uuid
  ref           String   @unique
  source        String   @default("catalog") // catalog | artist
  paintingId    Int
  paintingTitle String
  artist        String
  artworkId     String?  @db.Uuid
  imageUrl      String   @default("")
  sizeId        String
  frameId       String
  suggestedUsd   Int // server-computed indicative floor
  suggestedToman Int
  offeredUsd      Int
  offeredToman    Int
  offeredCurrency String @default("toman") // the currency the customer actually typed
  depositUsd    Int
  depositToman  Int
  customerName  String
  contact       String
  address       String
  note          String?
  status        String   @default("offer_pending")
  matchedArtistId     String?   @db.Uuid
  depositTrackingCode String?
  channelPostedAt     DateTime?
  depositConfirmedAt  DateTime?
  deliveredAt         DateTime?
  completedAt         DateTime?
  createdAt     DateTime @default(now())

  @@index([ref])
  @@index([status])
  @@map("orders")
}

// Shared, atomic fixed-window rate-limit counters (see src/lib/rate-limit.ts).
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
  @@map("rate_limits")
}

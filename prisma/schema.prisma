// Lotus data model — hand-painted wall-art commissioning.
// Guest checkout: an Order needs no user account. Prisma connects directly to
// Postgres; because there is no multi-tenant/user data here, all access is
// server-side only (API routes), never exposed to the browser.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A guest commission request for a hand-painted canvas.
model Order {
  id            String   @id @default(uuid()) @db.Uuid
  ref           String   @unique
  paintingId    Int
  paintingTitle String
  artist        String
  sizeId        String
  frameId       String
  priceUsd      Int
  customerName  String
  contact       String
  address       String
  note          String?
  status        String   @default("requested")
  createdAt     DateTime @default(now())

  @@index([ref])
  @@map("orders")
}

// Shared, atomic fixed-window rate-limit counters (see src/lib/rate-limit.ts).
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
  @@map("rate_limits")
}

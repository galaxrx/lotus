# Public site URL (used for metadata, sitemap, canonical, OG).
NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Database (Prisma → Postgres) — persists orders ---
# Use a Supabase/Neon/RDS Postgres. Pooled URL for the app, direct for migrations.
DATABASE_URL=
DIRECT_URL=

# --- Supabase (Auth + Storage for the artist portal) ---
# NEXT_PUBLIC_* are safe to expose. Service role is server-only; never commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram — where offers are delivered ---
# Create a bot with @BotFather for the token; use your chat/group id.
# The owner forwards the anonymized block to TELEGRAM_CHANNEL (the public auction).
# If unset, order dispatch is stubbed (the request still succeeds in-app).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL=@your_auction_channel

# --- Escrow (card-to-card, no international processor) ---
# ADMIN_TOKEN gates the /admin dashboard. OWNER_* are shown to the customer on the
# deposit-instruction page as the transfer target.
ADMIN_TOKEN=
OWNER_CARD_NUMBER=
OWNER_CARD_HOLDER=
OWNER_SHEBA=
